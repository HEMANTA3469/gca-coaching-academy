# Optional Render Blueprint example. A persistent disk requires a paid service plan.
services:
  - type: web
    name: gca-coaching-academy
    runtime: python
    plan: starter
    buildCommand: pip install -r requirements.txt
    startCommand: gunicorn app:app
    envVars:
      - key: SECRET_KEY
        generateValue: true
      - key: ADMIN_PASSWORD
        sync: false
      - key: DATABASE_PATH
        value: /var/data/gca_academy.db
      - key: UPLOAD_DIR
        value: /var/data/uploads
    disk:
      name: gca-academy-data
      mountPath: /var/data
      sizeGB: 1
